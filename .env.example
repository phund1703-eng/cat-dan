# ====================================================
# AutoVideoFactory — API Keys & Configuration
# Copy file này thành .env và điền thông tin của bạn
# ====================================================

# ===== LLM - Google Gemini (Hỗ trợ 2 Key tự động Failover khi chạm Quota 429) =====
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash      # hoặc gemini-3.7-flash
GEMINI_PRO_MODEL=gemini-3.8-flash    # dùng cho script chất lượng cao

# ===== TTS - Fish Audio =====
# Đăng ký tại: https://fish.audio
# Free tier: có credits ban đầu
FISH_AUDIO_API_KEY=your_fish_audio_key_here
FISH_AUDIO_VI_REFERENCE_ID=        # Voice ID tiếng Việt (sau khi clone)
FISH_AUDIO_EN_REFERENCE_ID=        # Voice ID tiếng Anh (sau khi clone)

# ===== Stock Media =====
# Pexels: https://www.pexels.com/api (miễn phí)
PEXELS_API_KEY=your_pexels_key_here

# Pixabay: https://pixabay.com/api (miễn phí)
PIXABAY_API_KEY=your_pixabay_key_here

# ===== Redis (Job Queue) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== Database =====
DATABASE_URL=sqlite:///data/autovideofactory.db

# ===== Postiz (Social Media Publisher - Self-hosted) =====
POSTIZ_URL=http://localhost:3000
POSTIZ_API_KEY=your_postiz_api_key_here

# ===== Paths =====
OUTPUT_DIR=data/output
CACHE_DIR=data/cache
ASSETS_DIR=assets

# ===== Video Settings =====
DEFAULT_VIDEO_QUALITY=1080p        # 720p hoặc 1080p
DEFAULT_LANGUAGE=vi                 # vi hoặc en
SUBTITLE_ENABLED=true
BACKGROUND_MUSIC_ENABLED=true
BACKGROUND_MUSIC_VOLUME=0.1        # 0.0-1.0

# ===== SadTalker (AI Avatar) =====
# Chỉ cần nếu dùng phong cách AI Avatar
SADTALKER_PATH=./tools/SadTalker   # Path đến SadTalker repo

# ===== Stable Diffusion WebUI =====
# Chỉ cần nếu dùng AI image generation
SD_WEBUI_URL=http://localhost:7860

# ===== Dashboard =====
DASHBOARD_PORT=8501
API_PORT=8000
SECRET_KEY=change_this_to_random_secret_key_for_production
