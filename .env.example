# ====================================================
# AutoVideoFactory — API Keys (BÍ MẬT)
# Copy file này thành .env và điền thông tin của bạn
# ----------------------------------------------------
# QUY ƯỚC (Giai đoạn 5.2): .env CHỈ chứa bí mật (API key, SECRET_KEY).
# Mọi cấu hình hành vi (model, TTS, chất lượng, nhạc nền, số job chạy
# đồng thời...) nằm ở config/settings.yaml — sửa ở đó, đừng thêm vào .env.
# Ngoại lệ duy nhất: GEMINI_MODEL / GEMINI_PRO_MODEL dưới đây là OVERRIDE
# tuỳ chọn — nếu đặt, chúng thắng llm.model / llm.pro_model trong
# settings.yaml; để trống (comment) thì dùng settings.yaml.
# ====================================================

# ===== LLM - Google Gemini (Hỗ trợ 2 Key tự động Failover khi chạm Quota 429) =====
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY=
# OVERRIDE tuỳ chọn (thắng settings.yaml llm.model) — bình thường để comment:
#GEMINI_MODEL=gemini-3.8-flash
# OVERRIDE tuỳ chọn (thắng settings.yaml llm.pro_model):
#GEMINI_PRO_MODEL=gemini-3.8-flash

# ===== TTS - Fish Audio =====
# Đăng ký tại: https://fish.audio
# Free tier: có credits ban đầu
FISH_AUDIO_API_KEY=your_fish_audio_key_here
FISH_AUDIO_VI_REFERENCE_ID=        # Voice ID tiếng Việt (sau khi clone)
FISH_AUDIO_EN_REFERENCE_ID=        # Voice ID tiếng Anh (sau khi clone)

# ===== Stock Media =====
# Pexels: https://www.pexels.com/api (miễn phí)
PEXELS_API_KEY=your_pexels_key_here

# Pixabay: https://pixabay.com/api (miễn phí)
PIXABAY_API_KEY=your_pixabay_key_here

# ===== Job Queue =====
# Từ Giai đoạn 4, hàng đợi chạy bằng worker poll DB (dashboard.worker.runner),
# KHÔNG còn dùng Redis/Celery. Số job chạy đồng thời: settings.yaml queue.max_concurrent_jobs.

# ===== Database =====
DATABASE_URL=sqlite:///data/autovideofactory.db

# ===== Postiz (Social Media Publisher - Self-hosted) =====
POSTIZ_URL=http://localhost:3000
POSTIZ_API_KEY=your_postiz_api_key_here

# ===== Paths =====
OUTPUT_DIR=data/output
CACHE_DIR=data/cache
ASSETS_DIR=assets

# (Chất lượng video / phụ đề / nhạc nền KHÔNG đặt ở .env nữa —
#  chỉnh trong config/settings.yaml mục video.*)

# ===== SadTalker (AI Avatar) =====
# Chỉ cần nếu dùng phong cách AI Avatar
SADTALKER_PATH=./tools/SadTalker   # Path đến SadTalker repo

# ===== Stable Diffusion WebUI =====
# Chỉ cần nếu dùng AI image generation
SD_WEBUI_URL=http://localhost:7860

# ===== Dashboard =====
DASHBOARD_PORT=8501
API_PORT=8000
SECRET_KEY=change_this_to_random_secret_key_for_production
# ^ SECRET_KEY cũng là X-API-Key bảo vệ endpoint ghi của API (Giai đoạn 5.4):
#   đặt giá trị ngẫu nhiên mạnh; để trống = API không khoá (chỉ dùng khi dev localhost).
